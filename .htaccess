Options -Indexes
SetEnv TRIBE_MAIL_TRANSPORT mail
SetEnv TRIBE_MAIL_FROM contact@tribeinn.com
SetEnv TRIBE_WHATSAPP_NUMBER 918169440389
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?:includes|config|pages|docs|tools|database|source-assets|var)(?:/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
